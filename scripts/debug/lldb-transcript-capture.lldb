settings set auto-confirm true
expr -l objc -O -- NSWindow *win = nil; for (NSWindow *w in [[NSApplication sharedApplication] windows]) { if ([w isVisible] && [w frame].size.width > 1000) { win = w; } } [[[win contentView] _subtreeDescription] writeToFile:@"/tmp/bento-viewtree.txt" atomically:YES encoding:4 error:nil]
expr -l objc -O -- NSMutableString *out = [NSMutableString string]; NSWindow *win = nil; for (NSWindow *w in [[NSApplication sharedApplication] windows]) { if ([w isVisible] && [w frame].size.width > 1000) { win = w; } } NSMutableArray *vq = [NSMutableArray arrayWithObject:[win contentView]]; while ([vq count] > 0) { NSView *v = [vq lastObject]; [vq removeLastObject]; for (NSView *sv in [v subviews]) { [vq addObject:sv]; } if ([v isKindOfClass:[NSClipView class]]) { NSView *doc = [(NSClipView *)v documentView]; if (doc && ![doc isKindOfClass:[NSTextView class]] && [doc frame].size.height > 700) { [out appendString:@"=== CLIP oy="]; [out appendString:[@([v bounds].origin.y) stringValue]]; [out appendString:@" visH="]; [out appendString:[@([v bounds].size.height) stringValue]]; [out appendString:@" docH="]; [out appendString:[@([doc frame].size.height) stringValue]]; [out appendString:@"\n"]; NSMutableArray *lq = [NSMutableArray arrayWithObject:[doc layer]]; NSMutableArray *ld = [NSMutableArray arrayWithObject:@0]; int emitted = 0; while ([lq count] > 0 && emitted < 2500) { CALayer *L = [lq lastObject]; [lq removeLastObject]; NSNumber *dnn = [ld lastObject]; [ld removeLastObject]; int dpt = [dnn intValue]; if (dpt < 7) { NSArray *subs = [L sublayers]; if (subs) { for (CALayer *sl in subs) { [lq addObject:sl]; [ld addObject:@(dpt+1)]; } } } emitted = emitted + 1; [out appendString:[@"" stringByPaddingToLength:(dpt*2) withString:@" " startingAtIndex:0]]; [out appendString:(NSString *)[L className]]; [out appendString:@" py="]; [out appendString:[(NSNumber *)[L valueForKeyPath:@"position.y"] stringValue]]; [out appendString:@" h="]; [out appendString:[(NSNumber *)[L valueForKeyPath:@"bounds.size.height"] stringValue]]; [out appendString:@" px="]; [out appendString:[(NSNumber *)[L valueForKeyPath:@"position.x"] stringValue]]; [out appendString:@" w="]; [out appendString:[(NSNumber *)[L valueForKeyPath:@"bounds.size.width"] stringValue]]; [out appendString:([L contents] != nil ? @" C=1" : @" C=0")]; [out appendString:([L isHidden] ? @" HID" : @"")]; if ([L delegate] != nil) { [out appendString:@" dlg="]; [out appendString:(NSString *)[(NSObject *)[L delegate] className]]; } [out appendString:@"\n"]; } [out appendString:@"--- emitted="]; [out appendString:(NSString *)[@(emitted) stringValue]]; [out appendString:@"\n"]; } } } [out writeToFile:@"/tmp/bento-layers.txt" atomically:YES encoding:4 error:nil]
detach
quit
